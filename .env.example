# GWASprocessing settings. .env.example is the tracked template and stays fixed; `bash src/source.sh` copies it
# to .env (untracked), fills in the paths and tool locations it knows, and leaves your own values alone on later
# runs. Edit .env, never .env.example; the only value you must add is OPENGWAS_JWT.
# Variables already set in the environment, and command-line options, win over .env.
# Relative paths are resolved against the repository root.

GWAS_MANIFEST=manifests/test.tsv
GWAS_CONFIG_ROOT=manifests
# Keep the data, reference and work roots on local or scratch storage, not in OneDrive/Dropbox/iCloud:
# synced folders upload every output and turn cloud-only reference files into a download on every run.
GWAS_WORK_ROOT=/WHERE/THE/GWAS/FILES/GO
GWAS_REFERENCE_ROOT=/WHERE/THE/REFERENCE/DATA/IS
GWAS_TEMP_ROOT=/WHERE/THE/TEMP/FILES/GO
GWAS_LOG_ROOT=/WHERE/THE/TEMP/FILES/GO/logs
GWAS_NEXTFLOW_WORK=/WHERE/THE/TEMP/FILES/GO/nextflow_work
GWAS_NEXTFLOW_LOG=/WHERE/THE/TEMP/FILES/GO/.nextflow.log
# Large intermediate files go here (default: the system temporary directory, which is node-local
# scratch under SLURM). Leave empty unless that location is small.
GWAS_TMPDIR=
# Raw reference downloads (about 35 GB, read once, start to finish): can be a slow or external drive.
# Empty = <GWAS_REFERENCE_ROOT>/raw. The built lookups stay under GWAS_REFERENCE_ROOT, which should be local disk.
GWAS_REFERENCE_RAW_ROOT=

# Run options. Inside an sbatch job the slurm profile is used regardless of GWAS_PROFILE.
GWAS_PROFILE=local
# Write the per-GWAS HTML report (true or false).
GWAS_REPORT=true
# Rows per invocation (empty = 1 for local, all for slurm).
GWAS_ROW_LIMIT=
# Pieces of a table standardised at once under the local profile (empty = 1); each needs about 2 GB of memory.
GWAS_WORKERS=

# Tools. src/source.sh installs everything into 1 private environment (environment.yml, with micromamba) under
# GWAS_TOOLS_ROOT (empty = .tools in the repository) and writes the locations below; set one yourself to use your
# own build, and src/source.sh keeps it.
GWAS_TOOLS_ROOT=
# GWAS_ENV=/path/to/.tools/env
# NEXTFLOW=/path/to/nextflow
# PLINK2=/path/to/plink2
# GWAS_BCFTOOLS=/path/to/bcftools
# BCFTOOLS_PLUGINS=/path/to/bcftools/plugins
# Optional: run every pipeline step inside the published image, with apptainer (clusters) or docker. Set with
# `bash src/source.sh --container apptainer`, which also pulls the image and writes GWAS_CONTAINER_IMAGE.
GWAS_CONTAINER=
# GWAS_CONTAINER_IMAGE=/path/to/.tools/gwasprocessing.sif

# Required for OpenGWAS sources. Generate/renew at https://api.opengwas.io/profile/
OPENGWAS_JWT=

# Reference downloads (src/reference_data/download_fasta_and_chains.sh). The defaults are shown.
HG19_TO_HG38_CHAIN_URL=https://hgdownload.soe.ucsc.edu/goldenPath/hg19/liftOver/hg19ToHg38.over.chain.gz
HG38_TO_HG19_CHAIN_URL=https://hgdownload.soe.ucsc.edu/goldenPath/hg38/liftOver/hg38ToHg19.over.chain.gz
FASTA_GRCH38_URL=https://ftp.ensembl.org/pub/release-113/fasta/homo_sapiens/dna/Homo_sapiens.GRCh38.dna.primary_assembly.fa.gz

# Service endpoints, only for mirrors: OPENGWAS_API_ROOT=https://api.opengwas.io/api
# GWAS_CATALOG_FTP_ROOT=https://ftp.ebi.ac.uk/pub/databases/gwas/summary_statistics
