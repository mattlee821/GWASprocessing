// Container profiles, combined with local or slurm (src/standardise.sh adds them when GWAS_CONTAINER is set in .env):
//   -profile slurm,apptainer   or   -profile local,docker
// Every process runs inside the GWASprocessing image, which holds the same tools as environment.yml. The data folders
// are not Nextflow inputs (the steps read and write them by path), so they are bound into the container explicitly.
// GWAS_CONTAINER_IMAGE: an Apptainer .sif pulled by src/source.sh, or a Docker image reference; default the published
// image.

profiles {
  apptainer {
    apptainer.enabled = true
    apptainer.autoMounts = true
    apptainer.runOptions = [params.repo_root, params.work_root, params.reference_root, params.config_root, params.log_root,
                            System.getenv('GWAS_TEMP_ROOT'), System.getenv('GWAS_TMPDIR')]
                           .findAll { it }.unique().collect { "--bind ${it}" }.join(' ')
    apptainer.envWhitelist = 'OPENGWAS_JWT,GWAS_WORKERS,GWAS_TABLE_CHUNK,GWAS_TMPDIR,GWAS_WORK_ROOT,GWAS_REFERENCE_ROOT,GWAS_CONFIG_ROOT,GWAS_LOG_ROOT'
    process.container = (System.getenv('GWAS_CONTAINER_IMAGE') ?: '').endsWith('.sif') ? System.getenv('GWAS_CONTAINER_IMAGE')
                        : "docker://${System.getenv('GWAS_CONTAINER_IMAGE') ?: 'ghcr.io/mattlee821/gwasprocessing:latest'}"
  }
  docker {
    docker.enabled = true
    docker.runOptions = '-u $(id -u):$(id -g) ' + [params.repo_root, params.work_root, params.reference_root, params.config_root,
                                                   params.log_root, System.getenv('GWAS_TEMP_ROOT'), System.getenv('GWAS_TMPDIR')]
                                                  .findAll { it }.unique().collect { "-v ${it}:${it}" }.join(' ')
    docker.envWhitelist = 'OPENGWAS_JWT,GWAS_WORKERS,GWAS_TABLE_CHUNK,GWAS_TMPDIR,GWAS_WORK_ROOT,GWAS_REFERENCE_ROOT,GWAS_CONFIG_ROOT,GWAS_LOG_ROOT'
    process.container = System.getenv('GWAS_CONTAINER_IMAGE') ?: 'ghcr.io/mattlee821/gwasprocessing:latest'
  }
}
