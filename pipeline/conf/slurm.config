profiles {
  slurm {
    process.executor = 'slurm'
    process.queue = params.slurm_queue
    process.cpus = 1
    process.memory = '8 GB'
    process.time = '4h'

    process {
      withName: STANDARDISE_ROW {
        // Tables and pre-built VCFs are processed in 1M-row pieces, under 3 GB per process. GWAS_WORKERS (.env) sets
        // how many pieces of 1 GWAS are standardised at once, as under the local profile: Nextflow passes it to the
        // script as --workers and asks SLURM for that many cpus and about 3 GB each on top of about 4 GB (at least 16 GB).
        // Keep the time well below the #SBATCH --time of src/standardise.sh, which runs the Nextflow head job.
        cpus = { (System.getenv('GWAS_WORKERS') ?: '1') as int }
        memory = { "${Math.max(16, 4 + 3 * task.cpus)} GB" }
        time = '12h'
      }
    }
  }
}
