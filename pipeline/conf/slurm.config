profiles {
  slurm {
    process.executor = 'slurm'
    process.queue = params.slurm_queue
    process.cpus = 1
    process.memory = '8 GB'
    process.time = '4h'

    process {
      withName: STANDARDISE_ROW {
        // Tables need about 1.6 GB plus 0.45 GB per million variants, so 16 GB covers ~30M variants;
        // pre-built VCFs are processed in 1M-record chunks. Keep the time well below the #SBATCH --time
        // of src/standardise.sh, which runs the Nextflow head job.
        memory = '16 GB'
        time = '12h'
      }
    }
  }
}
