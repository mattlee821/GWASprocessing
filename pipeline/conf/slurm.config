profiles {
  slurm {
    process.executor = 'slurm'
    process.queue = params.slurm_queue
    process.cpus = 1
    process.memory = '8 GB'
    process.time = '4h'

    process {
      withName: STANDARDISE_ROW {
        // Tables and pre-built VCFs are processed in 1M-row pieces, under 3 GB per process; the script runs
        // `cpus` pieces in parallel (--workers), so allow about 3 GB per cpu if cpus is raised.
        // Keep the time well below the #SBATCH --time of src/standardise.sh, which runs the Nextflow head job.
        memory = '16 GB'
        time = '12h'
      }
    }
  }
}
