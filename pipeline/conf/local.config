profiles {
  local {
    process.executor = 'local'
    process.cpus = 1
    process.memory = '4 GB'
    process.time = '2h'

    process {
      withName: STANDARDISE_ROW {
        // GWAS_WORKERS (server.env) sets how many pieces of a table are standardised at once; Nextflow passes it
        // to the script as --workers. Each worker needs about 2 GB on top of about 2 GB for the main process.
        // One row at a time (maxForks), so the workers are the only parallelism and memory stays predictable.
        cpus = { (System.getenv('GWAS_WORKERS') ?: '1') as int }
        memory = { "${2 + 2 * task.cpus} GB" }
        time = '12h'
        maxForks = 1
      }
    }
  }
}
