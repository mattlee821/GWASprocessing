manifest {
  name = 'gwas-vcf-standardisation'
  description = 'Persistent manifest-driven GWAS summary statistics standardisation to GWAS-VCF'
  nextflowVersion = '>=25.04.0'
}

params.repo_root = "${projectDir}/.."
params.pipeline_root = projectDir
params.manifest = "${projectDir}/../manifests/main.tsv"
params.work_root = "${projectDir}/../GWAS"
params.reference_root = "${projectDir}/../references"
params.config_root = "${projectDir}/../manifests"
params.log_root = "${projectDir}/../temp/logs"
params.study_yaml = ''
params.only_study = ''
params.force = false
params.dry_run = false
params.qcplot = true
params.row_limit = 0

process {
  // Manifest rows are independent, so a transient per-row failure should not
  // abort the rest of the fan-out: it is left out of state and retried next run.
  // Exit code 78 (EX_CONFIG) signals a configuration/authentication error the
  // user must fix (e.g. a missing or expired OPENGWAS_JWT); terminate the whole
  // run on that code so the prompt to supply a valid token is not missed.
  errorStrategy = { task.exitStatus == 78 ? 'terminate' : 'ignore' }
}

includeConfig 'conf/local.config'
includeConfig 'conf/slurm.config'
