manifest {
  name = 'gwas-vcf-standardisation'
  description = 'Persistent manifest-driven GWAS summary statistics standardisation to GWAS-VCF'
  nextflowVersion = '>=25.04.0'
}

params.repo_root = "${projectDir}/.."
params.pipeline_root = projectDir
params.manifest = "${projectDir}/../manifests/test.tsv"
params.work_root = "${projectDir}/../GWAS"
params.reference_root = "${projectDir}/../references"
params.config_root = "${projectDir}/../manifests"
params.log_root = "${projectDir}/../temp/logs"
params.study_yaml = ''
params.only_study = ''
params.force = false
params.dry_run = false
params.report = true
params.row_limit = 0
params.slurm_queue = 'low_p'

process {
  // Exit 78 (EX_CONFIG): setup the operator must fix for every row (an expired OPENGWAS_JWT, missing tools or
  // references) - stop the whole run. Exit 65 (EX_DATAERR): a problem with this row only (an unusable file, a build
  // that cannot be detected, a missing ancestry or study YAML) - record it as failed without retrying. Anything else (network, transient I/O) is retried once, then the row is left
  // out of state; src/standardise.sh lists failed rows and exits non-zero.
  errorStrategy = { task.exitStatus == 78 ? 'terminate' : ((task.exitStatus == 65 || task.attempt > 1) ? 'ignore' : 'retry') }
  maxRetries = 1

  withName: 'PREPARE_MANIFEST|UPDATE_STATE' {
    errorStrategy = 'terminate'
  }
}

includeConfig 'conf/local.config'
includeConfig 'conf/slurm.config'
includeConfig 'conf/container.config'
